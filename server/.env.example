# Copy to .env and fill in. .env is git-ignored; this file is committed.
# On a deployed host, set these in the dashboard instead: there is no .env there.

# Local:  postgresql://postgres:devpassword@localhost:5432/seatsaver
# Neon:   postgresql://user:pass@host.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:devpassword@localhost:5432/seatsaver

# Comma-separated, no trailing slash, no path. An origin is scheme + host + port.
CORS_ORIGINS=http://localhost:5173

# The shared password for the officer routes: creating events, and approving or
# rejecting requests. Officers type it into the dashboard once, and the browser
# sends it as the x-officer-key header.
#
# Make your own long random one, for example with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# Leave it unset and every officer route answers 503, which is the safe way to
# fail: no key means no entry, rather than no lock.
OFFICER_KEY=change-this-to-a-long-random-string

# Set to production on your host. Express and several libraries behave better,
# including not sending stack traces to your users.
NODE_ENV=development

# Do NOT set PORT locally or on the host. The host sets it for you.
